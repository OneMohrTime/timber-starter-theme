{# -- Component Variables -- #}

{% set this = {
    eyebrow: fields.eyebrow|default(null),
    headline: fields.headline|default(null),
    text: fields.text|default(null),
    button: fields.button|default(null),
    mediaType: fields.media_type|default('image'),
    aspectRatio: fields.aspect_ratio|default(null),
    image: fields.image|default(null),
    video: fields.video|default(null),
    slider: fields.slider|default(null),
    reverse: fields.reverse|default(false),
    bgColor: fields.background_color|default('white')
} %}

{# -- Component Template -- #}

<section class="o-section is-text-media has-{{ this.bgColor }}-background">

    {% include '_components/text-media.twig' with {
        params: {
            eyebrow: this.eyebrow,
            headline: this.headline,
            text: this.text,
            button: this.button,
            mediaType: this.mediaType,
            media : {
                image: this.image,
                video: this.video,
                slider: this.slider
            },
            aspectRatio: this.aspectRatio,
            alignment: this.reverse == 1 ? ' is-reversed' : '',
            hasBgColor: this.bgColor
        },
    } only %}

</section>
