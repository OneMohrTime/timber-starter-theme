{# -- Component Variables -- #}

{% set this = {
    eyebrow: fields.eyebrow|default(null),
    headline: fields.headline|default(null),
    text: fields.text|default(null),
    button: fields.button|default(null),
    mediaType: fields.media_type|default('image'),
    aspectRatio: fields.aspect_ratio|default(null),
    image: fields.image|default(null),
    video: fields.video|default(null),
    slider: fields.slider|default(null),
    reverse: fields.reverse|default(false),
    bgColor: fields.background_color|default('white')
} %}

{# -- Component Template -- #}

<div class="c-content" data-scroll-trigger>

    {% if this.eyebrow %}
        <strong class="u-eyebrow">{{ this.eyebrow }}</strong>
    {% endif %}

    {% if this.headline %}
        <h2 id="{{ this.headline|sanitize|slice(0, 24) }}" class="u-headline is-{{ this.headlineSize }}">{{ this.headline }}</h2>
    {% endif %}

    {% if this.text %}
        <div class="u-wysiwyg is-{{ this.textSize }}">
            {{ this.text }}
        </div>
    {% endif %}

    {% if this.button %}
        {% include '_elements/button.twig' with {
            params: {
                url: this.button.url,
                text: this.button.title,
                target: this.button.target,
                type: 'primary'
            }
        } only %}
    {% endif %}

</div>
