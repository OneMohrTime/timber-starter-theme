{# -- Base Page Layout -- #}
{# ----------------------------------------------------------------- #}
{% extends '_base/body.twig' %}

{# -- Page Variables -- #}
{# ----------------------------------------------------------------- #}

{# -- Page Template -- #}
{# ----------------------------------------------------------------- #}
{% block content %}
    <h2>{{ foo }}</h2>
    <p>{{ qux }}</p>
    {% for post in posts %}
        {% include ['_components/tease-' ~ post.post_type ~ '.twig', '_components/tease.twig'] %}
    {% endfor %}

    {% include '_components/pagination.twig' with { pagination: posts.pagination({show_all: false, mid_size: 3, end_size: 2}) } %}

    {% if post.children('page')|length > 0 %}
        <section class="o-section">
            <ul class="c-related-posts" data-scroll-trigger>

                {% for child in post.children('page') %}
                    <li class="c-related-posts__post">

                        {% include '_components/text-media.twig' with {
                            params: {
                                headline: child.post_headline|default(child.title),
                                text: child.content|excerpt(36),
                                button: {
                                    url: child.link,
                                    title: 'Learn More'
                                },
                                media: child.image|default(null),
                                alignment: loop.index is even ? ' is-reversed' : '',
                            }
                        } only %}

                    </li>
                {% endfor %}

            </ul>
        </section>
    {% endif %}
{% endblock %}
